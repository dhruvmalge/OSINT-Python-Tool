# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USER=admin
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-strong-password'))"
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash
# Set this to the deployed public origin, e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=
# Use a persistent PostgreSQL database URL in cloud deployments.
DATABASE_URL=sqlite:///analytics.db
TRUST_PROXY=1
COOKIE_SECURE=1
GEO_LOOKUP=1
RETENTION_DAYS=90
